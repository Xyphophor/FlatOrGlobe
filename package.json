{
  "name": "flat-or-globe",
  "version": "0.1.0",
  "license": "MIT AND CC-BY-4.0",
  "private": true,
  "type": "module",
  "description": "Flat plane or Globe? -- multi-file rewrite of the single-file comparison site.",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "check": "node scripts/check.js",
    "test": "node --test src/core/*.test.js src/tabs/**/*.test.js scripts/*.test.mjs",
    "audit:structure": "make -s fog && tools/bin/fog audit structure",
    "audit:tex": "make -s fog && tools/bin/fog audit tex",
    "audit:figures": "systemd-run --user --scope -p MemoryMax=1500M --quiet -- node scripts/audit_figures.mjs",
    "audit": "make -s fog && tools/bin/fog audit",
    "audit:prose": "make -s fog && tools/bin/fog audit prose"
  },
  "devDependencies": {
    "@resvg/resvg-wasm": "^2.6.2",
    "linkedom": "^0.18.13",
    "playwright": "^1.63.0",
    "vite": "^8.3.0"
  },
  "dependencies": {
    "gifenc": "^1.0.3",
    "mp4-muxer": "^5.2.2",
    "qrcode-generator": "^2.0.4",
    "three": "^0.186.0"
  }
}
